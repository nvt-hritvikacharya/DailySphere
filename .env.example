# --- Core ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dailysphere?schema=public"
# Signs session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string"
# Comma-separated emails/phones that are granted the ADMIN role on sign-in
ADMIN_EMAILS="admin@dailysphere.dev"
# Protects /api/cron/refresh (send as "Authorization: Bearer <secret>")
CRON_SECRET="change-me"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Auth ---
# Supabase email/phone OTP (server-side only). When unset:
#   - on Cursor app hosting, viewers sign in with their Cursor account
#   - in development, demo OTP mode is used (code 123456)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
# Demo OTP accepts code 123456 for ANY email — never enable on a public deployment.
ALLOW_DEMO_LOGIN="false"

# --- Content providers (all optional; mock/free fallbacks are used when empty) ---
# News: GNews takes priority over NewsAPI when both are set
GNEWS_API_KEY=""
NEWSAPI_KEY=""
# AI summaries (70-100 words). Falls back to extractive summaries.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Word of the Day via Wordnik (falls back to Free Dictionary API, then a curated list)
WORDNIK_API_KEY=""
# Default weather location when the browser denies geolocation (New Delhi)
DEFAULT_LAT="28.6139"
DEFAULT_LON="77.2090"
DEFAULT_CITY="New Delhi"
# Set to "true" to skip all network providers and use mocks only (useful offline/CI)
USE_MOCKS="false"
